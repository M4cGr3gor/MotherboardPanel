#include <windows.h>

#define IDI_APP 101

IDI_APP ICON "..\\RgbApp\\app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "FileDescription", "RGB Helper - efectos avanzados de RGB Control"
            VALUE "ProductName", "RGB Control"
            VALUE "FileVersion", "1.0.0"
            VALUE "OriginalFilename", "RGB Helper.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
