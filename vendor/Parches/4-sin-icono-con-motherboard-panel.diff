--- /dev/null
+++ b/library/motherboard_panel.py
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+# Detección de Motherboard Panel: un programa de bandeja que gestiona este monitor y otros módulos
+# con un único icono. Mientras está en marcha mantiene un mutex con nombre; si existe, el monitor
+# no muestra su propio icono en la bandeja.
+
+import platform
+
+MUTEX_NAME = "MotherboardPanel"
+
+
+def is_running(name: str = MUTEX_NAME) -> bool:
+    """True si existe el mutex con nombre `name` (Motherboard Panel en marcha)."""
+    if platform.system() != "Windows":
+        return False
+    try:
+        import win32api
+        import win32con
+        import win32event
+        handle = win32event.OpenMutex(win32con.SYNCHRONIZE, False, name)
+    except Exception:
+        return False
+    win32api.CloseHandle(handle)
+    return True
