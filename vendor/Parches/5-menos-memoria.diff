+++ b/library/memory.py
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+# Memoria del proceso en Windows. Tras arrancar, la mayor parte de la memoria del monitor (carga de
+# librerías, runtime .NET y detección del hardware de LibreHardwareMonitor) no se vuelve a usar, pero
+# Windows la sigue contando como suya (~125 MB). Devolverla deja el proceso en lo que usa de verdad
+# (~20 MB); lo que vuelva a necesitar lo recupera al momento.
+
+import platform
+
+
+def trim_working_set() -> bool:
+    """Devuelve a Windows la memoria que el proceso no está usando. False fuera de Windows o si falla."""
+    if platform.system() != "Windows":
+        return False
+    import ctypes
+    from ctypes import wintypes
+
+    kernel32 = ctypes.WinDLL("kernel32")
+    kernel32.GetCurrentProcess.restype = wintypes.HANDLE
+    kernel32.SetProcessWorkingSetSize.argtypes = [wintypes.HANDLE, ctypes.c_size_t, ctypes.c_size_t]
+    kernel32.SetProcessWorkingSetSize.restype = wintypes.BOOL
+    # (SIZE_T)-1 en los dos límites: vaciar el working set
+    size = ctypes.c_size_t(-1).value
+    return bool(kernel32.SetProcessWorkingSetSize(kernel32.GetCurrentProcess(), size, size))
